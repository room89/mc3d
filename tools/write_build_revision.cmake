execute_process(COMMAND git rev-parse HEAD WORKING_DIRECTORY "${SOURCE_DIR}"
  OUTPUT_VARIABLE REV OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET RESULT_VARIABLE STATUS)
execute_process(COMMAND git status --porcelain WORKING_DIRECTORY "${SOURCE_DIR}"
  OUTPUT_VARIABLE DIRTY ERROR_QUIET)
if(NOT STATUS EQUAL 0)
  set(REV "unknown")
endif()
set(DIRTY_FLAG "false")
if(DIRTY)
  set(DIRTY_FLAG "true")
endif()
file(MAKE_DIRECTORY "${BINARY_DIR}/generated")
set(TEXT "#pragma once\n#define MC3D_REV \"${REV}\"\n#define MC3D_DIRTY ${DIRTY_FLAG}\n")
set(DEST "${BINARY_DIR}/generated/build_revision.h")
set(OLD "")
if(EXISTS "${DEST}")
  file(READ "${DEST}" OLD)
endif()
if(NOT OLD STREQUAL TEXT)
  file(WRITE "${DEST}" "${TEXT}")
endif()
